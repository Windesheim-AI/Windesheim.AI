{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "jsx": "react",
        "types": ["jest", "node"],
        "noEmit": true,
        "baseUrl": "src",
        "paths": {
            "assets/*": ["assets/*"]
        }
    },
    "include": ["src/**/*", "declarations.d.ts"],
    "exclude": ["__tests__/*", "cypress/*"]
}
